NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada apenas no lado do servidor — NUNCA prefixar com NEXT_PUBLIC_.
# Agora é obrigatória (não só nas Edge Functions): o redirecionador
# /go/[id] (app/go/[id]/route.ts) precisa dela pra buscar o link de
# afiliado real sem expor a coluna pro navegador. Configure isso nas
# variáveis de ambiente da Vercel antes do deploy, ou o botão "Comprar
# na loja" vai quebrar.
SUPABASE_SERVICE_ROLE_KEY=

# Usadas apenas no lado do servidor (Edge Functions), nunca no frontend:
# SHOPEE_APP_ID=
# SHOPEE_SECRET=

# Domínio real do site, assim que for comprado — afeta canonical, Open
# Graph, sitemap.xml e schema.org (sem ela, cai no placeholder em lib/site.ts).
# NEXT_PUBLIC_SITE_URL=

# Analytics e monitoramento — cada um só carrega se a variável dele
# estiver preenchida (ver components/Analytics.tsx e instrumentation*.ts).
# Sem nenhuma delas, o site funciona 100% normal, só sem coletar dado.
#
# Google Analytics 4 — analytics.google.com, criar propriedade GA4,
# copiar o "ID de medição" (formato G-XXXXXXXXXX):
# NEXT_PUBLIC_GA_ID=
#
# Microsoft Clarity (mapa de calor + gravação de sessão) — grátis, sem
# limite de sessões: clarity.microsoft.com, copiar o "Project ID":
# NEXT_PUBLIC_CLARITY_ID=
#
# Google Search Console — Propriedade -> Verificação -> tag HTML,
# copiar só o valor do content="...":
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
#
# Sentry (monitoramento de erro) — sentry.io, plano Free cobre até 5 mil
# erros/mês, copiar o DSN do projeto:
# NEXT_PUBLIC_SENTRY_DSN=
